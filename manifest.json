{
  "manifest_version": 3,
  "name": "eBay & AliExpress to Dolibarr",
  "version": "2.12",
  "description": "Exporte et envoie vos transactions eBay et AliExpress vers Dolibarr via son API",
  "action": {
    "default_title": "eBay & AliExpress vers Dolibarr",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "permissions": [
    "activeTab",
    "storage",
    "windows",
    "scripting"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.ebay.fr/mye/myebay/purchase*",
        "https://www.ebay.com/mye/myebay/purchase*",
        "https://*.aliexpress.com/order/index.htm*",
        "https://*.aliexpress.com/p/order/index.htm*"
      ],
      "js": [ "content.js" ]
    }
  ]
}